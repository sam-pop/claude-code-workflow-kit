#!/usr/bin/env bash
# Stub of the Codex CLI for tests. Logs argv, the stdin prompt and a listing of the -C directory to
# $STUB_LOG; refuses like the real CLI outside a git repo unless --skip-git-repo-check is given;
# writes a short report to the -o file.
#   STUB_CODEX_FAIL_MODEL=<model>  exit 1 with an error when -m is that model
#   STUB_CODEX_RC=<n>              exit with n after logging (no report)
#   STUB_CODEX_TREE=1              also copy the -C directory to $STUB_LOG/codex.<n>.tree
# Also logs the GIT_CONFIG_* variables it was started with to $STUB_LOG/codex.<n>.env, and the exit
# code of `git rev-parse --git-dir` run in the -C directory (as Codex's own git would) to codex.<n>.gitrc.
log="${STUB_LOG:-/tmp}/codex"
n=1
while [[ -e "$log.$n.argv" ]]; do n=$((n + 1)); done
printf '%s\n' "$@" >"$log.$n.argv"
cat >"$log.$n.prompt"
out=""
dir=""
model=""
skip=0
prev=""
for a in "$@"; do
  case "$prev" in
    -o) out=$a ;;
    -C) dir=$a ;;
    -m) model=$a ;;
  esac
  [[ "$a" == --skip-git-repo-check ]] && skip=1
  prev=$a
done
if [[ $skip == 0 ]] && ! (cd "$dir" && git rev-parse --git-dir >/dev/null 2>&1); then
  echo "Not inside a trusted directory and --skip-git-repo-check was not specified." >&2
  exit 1
fi
env | grep '^GIT_CONFIG_' | sort >"$log.$n.env"
(cd "$dir" && git rev-parse --git-dir >/dev/null 2>&1; echo $? >"$log.$n.gitrc")
(cd "$dir" && find . -print | sort) >"$log.$n.ls"
[[ "${STUB_CODEX_TREE:-}" == 1 ]] && cp -R "$dir" "$log.$n.tree"
if [[ -n "${STUB_CODEX_FAIL_MODEL:-}" && "$model" == "$STUB_CODEX_FAIL_MODEL" ]]; then
  echo "error: model $model is not available" >&2
  exit 1
fi
if [[ -n "${STUB_CODEX_RC:-}" ]]; then
  echo "stub codex exiting ${STUB_CODEX_RC}" >&2
  exit "$STUB_CODEX_RC"
fi
printf '### Summary\nstub report from %s\n' "$model" >"$out"
